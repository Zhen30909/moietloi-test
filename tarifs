<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tarifs — moi & loi</title>
<meta name="description" content="Découvrez les offres moietloi.fr — accès libre, Pro et Institutionnel.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Source+Sans+3:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --vert:#5a7260;--vert-clair:#8a9e8a;--vert-pale:#eef3ee;
  --beige:#d4c8b0;--beige-clair:#ede8df;
  --peche:#d4956a;--peche-pale:#faf0e8;
  --gris-fonce:#2d2d2d;--gris-moyen:#6b6b6b;--gris-clair:#b0b0b0;
  --fond:#f7f4ef;--blanc:#ffffff;
  --or:#b8943f;--or-pale:#fdf8ee;--or-clair:#e8d0a0;
  --bleu:#2c4a6e;--bleu-pale:#eef2f7;--bleu-clair:#c0d0e0;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Source Sans 3',sans-serif;background:var(--fond);color:var(--gris-fonce);min-height:100vh}

/* NAV */
nav{background:rgba(247,244,239,0.96);backdrop-filter:blur(10px);border-bottom:1px solid var(--beige);height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:100}
.nav-logo{font-family:'Playfair Display',serif;font-size:1.35rem;color:var(--gris-fonce);text-decoration:none}
.nav-logo .et{color:var(--peche);font-style:italic}
.nav-logo .loi{color:var(--vert)}
.nav-links{display:flex;gap:4px;align-items:center}
.nav-links a{font-size:0.85rem;color:var(--gris-moyen);text-decoration:none;padding:7px 12px;border-radius:6px;transition:all 0.2s}
.nav-links a:hover{color:var(--vert);background:var(--vert-pale)}
.nav-links a.active{color:var(--vert);font-weight:600;background:var(--vert-pale);pointer-events:none}
.nav-cta{background:var(--vert)!important;color:white!important;font-weight:500!important}
.nav-cta:hover{background:#4a6050!important}
.nav-burger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px}
.nav-burger span{display:block;width:22px;height:2px;background:var(--gris-fonce);border-radius:2px}
.nav-mob{display:none;position:fixed;top:58px;left:0;right:0;background:var(--blanc);border-bottom:1px solid var(--beige);padding:16px 24px 20px;z-index:190;flex-direction:column;gap:4px;box-shadow:0 8px 24px rgba(0,0,0,0.07)}
.nav-mob.open{display:flex}
.nav-mob a{font-size:0.95rem;color:var(--gris-fonce);text-decoration:none;padding:10px 12px;border-radius:8px}
.nav-mob a:hover{background:var(--fond)}
.nav-mob a.active{color:var(--vert);font-weight:600;background:var(--vert-pale)}
.nav-cta-mob{background:var(--vert);color:white!important;font-weight:500;margin-bottom:4px}

/* PAGE */
.page{max-width:1060px;margin:0 auto;padding:48px 24px 80px}
.page-eyebrow{font-size:0.7rem;text-transform:uppercase;letter-spacing:2.5px;color:var(--vert);font-weight:500;margin-bottom:10px;text-align:center}
.page-title{font-family:'Playfair Display',serif;font-size:2rem;color:var(--gris-fonce);margin-bottom:10px;text-align:center}
.page-desc{font-size:0.93rem;color:var(--gris-moyen);line-height:1.65;text-align:center;max-width:560px;margin:0 auto 48px}

/* TOGGLE */
.billing-toggle{display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:40px}
.bt-label{font-size:0.88rem;color:var(--gris-moyen)}
.bt-label.on{color:var(--gris-fonce);font-weight:500}
.toggle-wrap{position:relative;width:48px;height:26px;cursor:pointer}
.toggle-wrap input{opacity:0;width:0;height:0;position:absolute}
.toggle-slider{position:absolute;inset:0;background:#ddd8d0;border-radius:13px;transition:0.3s}
.toggle-wrap input:checked+.toggle-slider{background:var(--vert)}
.toggle-slider::before{content:'';position:absolute;height:20px;width:20px;left:3px;bottom:3px;background:white;border-radius:50%;transition:0.3s}
.toggle-wrap input:checked+.toggle-slider::before{transform:translateX(22px)}
.saving-badge{font-size:0.75rem;background:var(--vert-pale);color:var(--vert);padding:3px 10px;border-radius:12px;font-weight:500}

/* PLANS */
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:48px;align-items:start}
.plan{background:var(--blanc);border-radius:16px;padding:28px;border:1.5px solid #e8e2d8;transition:all 0.2s;position:relative}
.plan:hover{box-shadow:0 8px 32px rgba(0,0,0,0.08);transform:translateY(-2px)}
.plan.highlight{border-color:var(--or);box-shadow:0 8px 32px rgba(184,148,63,0.15)}
.plan.inst{border-color:var(--bleu-clair)}
.plan-ribbon{position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:var(--or);color:white;font-size:0.68rem;font-weight:600;padding:4px 16px;border-radius:0 0 8px 8px;letter-spacing:0.5px;white-space:nowrap}
.plan-icon{font-size:1.8rem;margin-bottom:14px}
.plan-name{font-size:0.72rem;text-transform:uppercase;letter-spacing:2px;font-weight:600;margin-bottom:8px}
.plan-name.f{color:var(--vert)}.plan-name.p{color:var(--or)}.plan-name.i{color:var(--bleu)}
.plan-price{font-family:'Playfair Display',serif;font-size:2.4rem;color:var(--gris-fonce);font-weight:700;line-height:1;margin-bottom:4px}
.plan-price.inst{font-size:1.4rem;padding-top:8px}
.plan-period{font-size:0.78rem;color:var(--gris-moyen);margin-bottom:6px}
.plan-annual{font-size:0.78rem;color:var(--vert);font-weight:500;margin-bottom:20px;min-height:20px}
.plan-desc{font-size:0.85rem;color:var(--gris-moyen);line-height:1.6;margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid var(--beige-clair)}
.plan-features{margin-bottom:24px}
.pf{display:flex;align-items:flex-start;gap:10px;padding:6px 0;font-size:0.84rem;color:var(--gris-fonce);line-height:1.5}
.pf-icon{flex-shrink:0;font-size:0.9rem;margin-top:1px}
.pf.off{color:var(--gris-clair)}
.pf.off .pf-icon{opacity:0.4}
.pf-section{font-size:0.68rem;text-transform:uppercase;letter-spacing:1.5px;color:var(--gris-clair);margin-top:12px;margin-bottom:4px;font-weight:500}
.btn-plan{width:100%;padding:13px;border:none;border-radius:9px;font-size:0.95rem;font-family:'Source Sans 3',sans-serif;font-weight:500;cursor:pointer;transition:all 0.2s}
.btn-plan.f{background:var(--vert-pale);color:var(--vert)}.btn-plan.f:hover{background:var(--vert);color:white}
.btn-plan.p{background:var(--or);color:white}.btn-plan.p:hover{background:#9a7c30}
.btn-plan.i{background:var(--bleu);color:white}.btn-plan.i:hover{background:#1e3550}

/* TABLEAU COMPARATIF */
.compare-title{font-family:'Playfair Display',serif;font-size:1.3rem;color:var(--gris-fonce);text-align:center;margin-bottom:24px}
.compare-table{width:100%;border-collapse:collapse;background:var(--blanc);border-radius:12px;overflow:hidden;border:1px solid #e8e2d8;box-shadow:0 2px 8px rgba(0,0,0,0.04)}
.compare-table th{padding:16px 20px;font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;border-bottom:2px solid var(--beige)}
.compare-table th:first-child{text-align:left;color:var(--gris-moyen);width:35%}
.compare-table th.f{color:var(--vert);text-align:center}
.compare-table th.p{color:var(--or);text-align:center;background:rgba(184,148,63,0.05)}
.compare-table th.i{color:var(--bleu);text-align:center}
.compare-table td{padding:12px 20px;font-size:0.85rem;border-bottom:1px solid #f5f2ee;vertical-align:middle}
.compare-table td:first-child{color:var(--gris-moyen);font-weight:400}
.compare-table td:not(:first-child){text-align:center}
.compare-table td.p-col{background:rgba(184,148,63,0.03)}
.compare-table tr:last-child td{border-bottom:none}
.compare-table tr.section-row td{background:var(--fond);font-size:0.72rem;text-transform:uppercase;letter-spacing:1.5px;color:var(--gris-clair);font-weight:500;padding:10px 20px}
.check{color:var(--vert);font-size:1rem;font-weight:600}
.check.or{color:var(--or)}
.check.bl{color:var(--bleu)}
.cross{color:var(--gris-clair);font-size:0.9rem}
.partial{color:var(--gris-moyen);font-size:0.82rem}

/* FAQ */
.faq{margin-top:48px}
.faq-title{font-family:'Playfair Display',serif;font-size:1.3rem;color:var(--gris-fonce);margin-bottom:20px;text-align:center}
.faq-item{background:var(--blanc);border:1px solid #e8e2d8;border-radius:10px;margin-bottom:10px;overflow:hidden}
.faq-q{padding:16px 20px;font-size:0.92rem;font-weight:500;color:var(--gris-fonce);cursor:pointer;display:flex;justify-content:space-between;align-items:center;transition:background 0.2s}
.faq-q:hover{background:var(--fond)}
.faq-q .faq-arrow{transition:transform 0.2s;color:var(--gris-moyen);font-size:0.8rem}
.faq-item.open .faq-arrow{transform:rotate(180deg)}
.faq-a{display:none;padding:0 20px 16px;font-size:0.87rem;color:var(--gris-moyen);line-height:1.7}
.faq-item.open .faq-a{display:block}

@media(max-width:860px){.plans{grid-template-columns:1fr}}
@media(max-width:600px){
  nav{padding:0 18px}.nav-links{display:none}.nav-burger{display:flex}
  .page{padding:32px 16px 60px}
  .compare-table{font-size:0.78rem}
  .compare-table th,.compare-table td{padding:10px 12px}
}
</style>
</head>
